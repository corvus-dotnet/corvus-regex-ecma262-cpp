# The corvus-regex-ecma262 C++ library, as imported targets:
#   corvus_regex_ecma262_cpp::corvus_regex_ecma262_cpp         the header, over the C library's shared library
#   corvus_regex_ecma262_cpp::corvus_regex_ecma262_cpp_static  the header, over the C library's static library
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(corvus_regex_ecma262 @CORVUS_REGEX_ECMA262_C_VERSION@ CONFIG
  HINTS "${PACKAGE_PREFIX_DIR}/lib/cmake/corvus_regex_ecma262")

include("${CMAKE_CURRENT_LIST_DIR}/corvus_regex_ecma262_cppTargets.cmake")
check_required_components(corvus_regex_ecma262_cpp)
